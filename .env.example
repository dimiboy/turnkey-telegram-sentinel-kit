# ==============================================================================
# Telegram Sentinel & Server Alert Stack - Configuration
# ==============================================================================

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Target Chat or Admin ID (Get from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# Server Identifier (Shown in alert header)
SERVER_NAME=HomeLab-Primary

# Alerting Thresholds
CPU_THRESHOLD_PERCENT=85
RAM_THRESHOLD_PERCENT=90
DISK_THRESHOLD_PERCENT=90

# Check Interval in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60

# Rate Limiting: Minimum minutes between identical warning alerts
ALERT_COOLDOWN_MINUTES=15
